[Container]
#////////////////////////////////////////
Image=docker.io/dpage/pgadmin4:9.5
#DEMO V2 update (new image version) -> comment out version 9.5
#Image=docker.io/dpage/pgadmin4:9.6
#////////////////////////////////////////
Network=quad-postgres-net.network
PublishPort=5050:80
Environment=PGADMIN_DEFAULT_EMAIL=admin@none.com
Environment=PGADMIN_DEFAULT_EMAIL=secure

[Service]
Restart=always

[Install]
WantedBy=default.target